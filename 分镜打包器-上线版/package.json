{
  "name": "storyboard-packager",
  "version": "0.1.0",
  "author": "sk0l",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1",
    "build": "node scripts/vinext-build.mjs",
    "start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File scripts/local-static-server.ps1 -Root dist/client",
    "lint": "oxlint -A jsx-a11y/no-noninteractive-element-interactions app components/storyboard-workbench.tsx lib scripts vite.config.ts",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@zip.js/zip.js": "2.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module",
  "license": "MIT"
}
